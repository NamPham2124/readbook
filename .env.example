# =============================================================================
# ReadBook Web Application - Environment Variables Template
# =============================================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Server-Only Secret (NEVER expose to browser / client side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Initial Admin User Credentials (Used by scripts/seed-admin.ts)
# WARNING: Change these credentials immediately in production!
ADMIN_EMAIL=admin@readbook.local
ADMIN_PASSWORD=admin123456!

# Application Configuration
NEXT_PUBLIC_APP_NAME=ReadBook
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_BOOK_SIZE_MB=200
